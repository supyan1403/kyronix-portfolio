{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=${FIGMA_API_KEY}",
        "--proxy",
        "none",
        "--stdio"
      ],
      "enabled": true
    },
    "talk-to-figma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "cursor-talk-to-figma-mcp"
      ],
      "enabled": true
    }
  }
}