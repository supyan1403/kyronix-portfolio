# Keep small site assets off LFS — Vercel Git clone does NOT fetch LFS blobs (PDF 131 byte pointer -> viewer blank icon)
# Fonts/images tiny kept off LFS to prevent 9.66GB Image Storage bloat per deploy
favicon.png -filter -diff -merge -text
favicon-*.png -filter -diff -merge -text
kyronix-k-retro.webp -filter -diff -merge -text
*.png -filter -diff -merge -text
*.webp -filter -diff -merge -text
*.pdf -filter -diff -merge -text
*.jpg -filter -diff -merge -text
*.jpeg -filter -diff -merge -text
*.mp4 -filter -diff -merge -text
